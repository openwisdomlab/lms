    "@tiptap/starter-kit": "^2.11.0",
    "@tiptap/suggestion": "^2.11.0",
    "@xyflow/react": "^12.3.0",
    "ai": "^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "convex": "^1.29.3",
