# =============================================================================
# Convex Configuration (Primary Database)
# =============================================================================
# Option 1: Convex Cloud (default)
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
CONVEX_DEPLOY_KEY=your_convex_deploy_key

# Option 2: Self-Hosted Convex (takes priority over cloud if set)
# Use this when running Convex locally via Docker or on your own infrastructure
# NEXT_PUBLIC_CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# CONVEX_SELF_HOSTED_ADMIN_KEY=your_admin_key_from_generate_admin_key_script

# Self-hosted production URLs (when deploying frontend to Vercel)
# CONVEX_CLOUD_ORIGIN=https://api.your-domain.com
# CONVEX_SITE_ORIGIN=https://your-domain.com

# =============================================================================
# Convex Auth Configuration (OAuth Providers)
# =============================================================================
# GitHub OAuth
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

# Google OAuth
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# JWT Secret (for Convex Auth)
CONVEX_AUTH_PRIVATE_KEY=your_private_key_here
CONVEX_AUTH_PUBLIC_KEY=your_public_key_here

# =============================================================================
# OpenAI (for AI features)
# =============================================================================
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# App Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Legacy Supabase Configuration (DEPRECATED - Will be removed)
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
